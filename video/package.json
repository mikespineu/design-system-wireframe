{
  "name": "design-system-video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Promo video for the design system, built with Remotion. Standalone package, not an npm workspace.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "node scripts/still.mjs",
    "render": "remotion render src/index.ts placeholder-default out/placeholder-default.mp4",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0",
    "vitest": "^4.0.0"
  }
}
