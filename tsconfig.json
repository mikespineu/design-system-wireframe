{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["jest", "@testing-library/jest-dom"],
    "paths": { "design-system-test": ["./src/index.ts"] }
  },
  "include": ["src", "docs/theming-guide", "scripts/*.test.ts", "test", ".storybook", "jest.setup.ts", "*.d.ts"]
}
